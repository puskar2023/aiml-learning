import matplotlib.pyplot as plt


x = [1, 2, 3, 4]
y = [5, 6, 7, 8]

plt.plot(x, y) #line plot
plt.show()


# Movies Data

# Oscar Winner Movies
oscar_movies = [
    "The Dark Knight", 
    "The Hurt Locker",  
    "The King's Speech", 
    "The Artist",     
    "Argo"
]
oscar_years = [2008, 2009, 2010, 2011, 2012]
oscar_revenue = [1005, 170, 427, 133, 232]  # in $M

plt.plot(oscar_years, oscar_revenue)

plt.title("Oscar Years vs Revenue(in $M)")
plt.xlabel("Years")
plt.ylabel("Revenue(in $M)")


# Plot multiple
# Non-Oscar Winner Movies
non_oscar_movies = ["Slumdog Millionaire","Avatar","Inception","Hugo","Lincoln"]
non_oscar_years = [2008, 2009, 2010, 2011, 2012]
non_oscar_revenue = [378, 2788, 829, 185, 275]  # in $M

plt.plot(oscar_years, oscar_revenue, color = "red", marker = "o", linestyle = "--", linewidth = 6, label="Oscar Winners")
plt.plot(non_oscar_years, non_oscar_revenue, "<-b", label="Non-Oscar Winners")
plt.title("Oscar Movies vs Non-Oscar Movies Revenue(in $M)")
plt.xlabel("Years")
plt.ylabel("Revenue(in $M)")
plt.legend()
# plt.legend(loc="upper right")
# plt.legend(loc="upper left")
# plt.legend(loc="center")


# Other Methods & Attributes
with plt.xkcd():
    plt.plot(oscar_years, oscar_revenue, label="Oscar Winners")
    plt.plot(non_oscar_years, non_oscar_revenue, label="Non-Oscar Winners")
    plt.title("Oscar Movies vs Non-Oscar Movies Revenue(in $M)")
    plt.xlabel("Years")
    plt.ylabel("Revenue(in $M)")
    plt.legend()
    
    print(plt.style.available)
    
    # plt.style.use("default")
    plt.grid()
    plt.show()


